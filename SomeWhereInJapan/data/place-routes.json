        {
          "id": "nikko-toshogu",
          "order": 3,
          "name": "Nikko Toshogu Shrine",
          "area": "Sannai, Nikko",
          "address": "Nikko Toshogu Shrine, 2301 Sannai, Nikko, Tochigi, Japan",
          "story": "Toshogu is the richly carved mausoleum shrine of Tokugawa Ieyasu. Give the precinct time: the famous Three Wise Monkeys and Yomeimon Gate are among many details along the visitor route.",
          "coordinates": {
            "latitude": 36.7560462,
